<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:minWidth="140dp">

    <!-- En-tête -->
    <TextView
        android:id="@+id/tv_titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="🚗 VTC"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Badge état -->
    <TextView
        android:id="@+id/tv_etat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:background="@drawable/badge_background"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="EN REPOS"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Chronomètre -->
    <TextView
        android:id="@+id/tv_temps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:text="⏱️ 00:00"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Revenu -->
    <TextView
        android:id="@+id/tv_revenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:text="💰 0,00 €"
        android:textColor="#FFD700"
        android:textSize="14sp" />

    <!-- Boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:backgroundTint="#FFFFFF"
            android:text="▶ DÉMARRER"
            android:textColor="#1a1a2e"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_secondaire"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#40FFFFFF"
            android:text="ANNULER"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
